{
  "$schema": "https://raw.githubusercontent.com/kmontocam/amox/main/schema/dictConfig.json",
  "disable_existing_loggers": false,
  "formatters": {
    "amox": {
      "()": "amox.formatters.create_formatter"
    }
  },
  "handlers": {
    "amox": {
      "()": "amox.handlers.create_handler",
      "formatter": "amox",
      "root": true
    }
