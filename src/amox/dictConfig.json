{
  "$schema": "https://raw.githubusercontent.com/kmontocam/amox/main/schema/dictConfig.json",
  "disable_existing_loggers": false,
  "formatters": {
    "amox": {
      "()": "amox.create_formatter",
      "root": true
    }
  },
  "handlers": {
    "amox": {
      "class": "logging.StreamHandler",
      "formatter": "amox",
      "stream": "ext://sys.stderr"
    },
    "amox.LiveQueueHandler": {
      "class": "amox.handlers.LiveQueueHandler",
      "handlers": [
        "amox"
      ],
      "respect_handler_level": true
    }
  },
  "root": {
    "handlers": [
      "amox.LiveQueueHandler"
    ]
  },
  "version": 1
}
