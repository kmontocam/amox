{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
  },
  "mcp": {
    "gh-actions": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/actions",
    },
  },
}
